# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Elastic Cloud Serverless
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Elastic index names (defaults work for most setups)
ELASTIC_INDEX_PLAYERS=kiasuhealth-players
ELASTIC_INDEX_METRICS=kiasuhealth-metrics
ELASTIC_INDEX_LEAGUES=kiasuhealth-leagues
ELASTIC_INDEX_REVEALS=kiasuhealth-reveals
ELASTIC_INDEX_ECG=kiasuhealth-ecg

# Agent IDs — set these after creating agents in Kibana → Agent Builder
# (Prep Day task P0: copy the generated agent IDs from the Kibana UI)
HEALTH_COACH_AGENT_ID=
REFEREE_AGENT_ID=

# Amazon Bedrock (used by MealAnalyzerAgent tool — configured in Kibana, not in code)
# Provide these to the Kibana tool config, NOT as Next.js env vars
AWS_REGION=ap-southeast-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-haiku-3

# App URL (set to your Vercel URL after deploy)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Reaction messages use emoji-only text (no GIFs)

# Default league for demo
DEFAULT_LEAGUE_ID=sg-league-001
